{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ASLS Studio",
  "version": "0.1.0",
  "identifier": "com.asls.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run tauri:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ASLS Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public": "public"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
